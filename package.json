
{
  "name": "seamless-pro-viewer",
  "version": "1.0.0",
  "description": "High-performance offline image viewer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "echo 'Deploying static files...'",
    "build:exe": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.seamless.viewer",
    "productName": "SeamlessPro",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    }
  }
}
